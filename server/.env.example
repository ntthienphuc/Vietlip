LIP_MODEL_BACKEND=auto_avsr
LIP_MODEL_LOAD_ON_STARTUP=false
LIP_DEVICE=auto
LIP_PRECISION=auto
LIP_ALLOW_CPU_FALLBACK=true
# 0 = automatically use up to 12 logical CPU threads.
LIP_CPU_THREADS=0
LIP_MAX_UPLOAD_BYTES=104857600
LIP_MAX_FRAMES=1125
LIP_MIN_FRAMES=8
LIP_TARGET_FPS=25
LIP_MAX_QUEUED_JOBS=8
LIP_JOB_RETENTION_SECONDS=1800
LIP_REALTIME_ENABLED=true
LIP_REALTIME_SAMPLE_FPS=8
LIP_REALTIME_MIN_SECONDS=2
LIP_REALTIME_DECODE_INTERVAL_SECONDS=2
LIP_REALTIME_WINDOW_SECONDS=6
LIP_REALTIME_OVERLAP_SECONDS=1
LIP_REALTIME_MAX_SECONDS=300
LIP_REALTIME_MAX_FRAME_BYTES=1048576
# Frozen ViCocktail evaluation decoder: beam-10, N-best-10, CTC 0.1.
LIP_BEAM_SIZE=10
LIP_NBEST=10
LIP_CTC_WEIGHT=0.1
AUTO_AVSR_CHECKPOINT=D:\Project\Lip_App\Lip_Final\06_CHECKPOINT\epoch=13-step=55986-002.ckpt
LIP_MODEL_ID=auto-avsr-vi-release-2026.07
AUTO_AVSR_ROOT=D:\Project\Lip_App\Lip_Final\02_PROJECT_MAIN\main_code_results_phase\baselines\auto_avsr
VSR_SPM_MODEL=D:\Project\Lip_App\Lip_Final\02_PROJECT_MAIN\main_code_results_phase\benchmark_v1\vocabulary\vi_unigram_2000.model
VSR_SPM_UNITS=D:\Project\Lip_App\Lip_Final\02_PROJECT_MAIN\main_code_results_phase\benchmark_v1\vocabulary\vi_unigram_2000.auto_avsr_units.txt
# Optional OpenAI-compatible post-processor. Raw visual transcript is always kept.
LIP_LLM_PROVIDER=ollama
LIP_LLM_BASE_URL=http://127.0.0.1:11434
# Optional for local OpenAI-compatible providers that do not require auth.
LIP_LLM_API_KEY=
LIP_LLM_MODEL=qwen2.5:7b
LIP_LLM_TIMEOUT_SECONDS=90
LIP_LLM_NUM_CTX=2048
LIP_LLM_MAX_OUTPUT_TOKENS=320
# 0 unloads Ollama immediately after each response to free RAM for VSR.
LIP_LLM_KEEP_ALIVE=0
