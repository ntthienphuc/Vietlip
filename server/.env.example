# VietLip visual-only server. Paths default relative to server/.
LIP_MODEL_BACKEND=native_avsr
LIP_MODEL_LOAD_ON_STARTUP=true
LIP_STARTUP_WARMUP=1
LIP_MODEL_ID=auto-avsr-vi-so_seed17
LIP_DEVICE=auto
LIP_PRECISION=float32
LIP_ALLOW_CPU_FALLBACK=true
LIP_CPU_THREADS=4
LIP_TARGET_FPS=25
LIP_BEAM_SIZE=10
LIP_NBEST=10
LIP_CTC_WEIGHT=0.1
LIP_REALTIME_ENABLED=true
LIP_REALTIME_SAMPLE_FPS=25
LIP_REALTIME_MIN_SECONDS=2
LIP_REALTIME_DECODE_INTERVAL_SECONDS=1.5
LIP_REALTIME_WINDOW_SECONDS=6
LIP_REALTIME_OVERLAP_SECONDS=1
LIP_REALTIME_MAX_SECONDS=300
LIP_REALTIME_DECODER=beam
LIP_REALTIME_BEAM_SIZE=3
LIP_MAX_UPLOAD_BYTES=104857600
LIP_MAX_FRAMES=1125
LIP_MIN_FRAMES=8
LIP_MAX_QUEUED_JOBS=8
LIP_JOB_RETENTION_SECONDS=1800
LIP_REALTIME_MAX_FRAME_BYTES=1048576
