FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    LIP_DEVICE=cpu \
    LIP_PRECISION=float32 \
    LIP_MODEL_LOAD_ON_STARTUP=true \
    LIP_MAX_QUEUED_JOBS=8 \
    LIP_JOB_RETENTION_SECONDS=1800 \
    AUTO_AVSR_CHECKPOINT=/models/epoch=13-step=55986-002.ckpt \
    AUTO_AVSR_ROOT=/models/auto_avsr \
    VSR_SPM_MODEL=/models/vocabulary/vi_unigram_2000.model \
    VSR_SPM_UNITS=/models/vocabulary/vi_unigram_2000.auto_avsr_units.txt

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg libglib2.0-0 libgl1 libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/lip-reader
COPY server/requirements-api.txt server/requirements-model.txt server/requirements-cpu.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-cpu.txt

COPY server/app ./app

RUN useradd --create-home --uid 10001 lipreader \
    && chown -R lipreader:lipreader /opt/lip-reader
USER lipreader

EXPOSE 7100
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
  CMD curl --fail http://127.0.0.1:7100/healthz || exit 1

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7100", "--workers", "1"]
