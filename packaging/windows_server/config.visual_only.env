LIP_MODEL_BACKEND=auto_avsr
LIP_MODEL_LOAD_ON_STARTUP=true
LIP_DEVICE=auto
LIP_PRECISION=auto
LIP_ALLOW_CPU_FALLBACK=true
LIP_CPU_THREADS=0
LIP_MAX_UPLOAD_BYTES=104857600
LIP_MAX_FRAMES=1125
LIP_MIN_FRAMES=8
LIP_TARGET_FPS=25
LIP_MAX_QUEUED_JOBS=8
LIP_JOB_RETENTION_SECONDS=1800
LIP_REALTIME_ENABLED=true
LIP_REALTIME_SAMPLE_FPS=8
LIP_REALTIME_MIN_SECONDS=2
LIP_REALTIME_DECODE_INTERVAL_SECONDS=2
LIP_REALTIME_WINDOW_SECONDS=6
LIP_REALTIME_OVERLAP_SECONDS=1
LIP_REALTIME_MAX_SECONDS=300
LIP_REALTIME_MAX_FRAME_BYTES=1048576
LIP_BEAM_SIZE=10
LIP_NBEST=10
LIP_CTC_WEIGHT=0.1
LIP_MAX_CONTEXT_CHARS=100

# Visual-only works without an LLM. The optional installer step replaces these
# values after Ollama and qwen2.5:7b are ready.
LIP_LLM_PROVIDER=disabled
LIP_LLM_BASE_URL=
LIP_LLM_API_KEY=
LIP_LLM_MODEL=
LIP_LLM_TIMEOUT_SECONDS=90
LIP_LLM_NUM_CTX=2048
LIP_LLM_MAX_OUTPUT_TOKENS=320
LIP_LLM_KEEP_ALIVE=0
